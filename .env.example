# DashScope（通义 / qwen 系列）— Supervisor 使用
DASHSCOPE_API_KEY=your_dashscope_api_key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-max

# DeepSeek — 专家 Agent 使用（Security / Logic / Quality / Performance）
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com

GITCODE_TOKEN=your_gitcode_personal_access_token
GITCODE_BASE_URL=https://gitcode.com
WEBHOOK_SECRET=your_webhook_secret_token

MYSQL_URL=mysql+aiomysql://reviewer:reviewer@localhost:3306/reviewer
REDIS_URL=redis://localhost:6379
ES_URL=http://localhost:9200

MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=8081

# 并发控制
MAX_CONCURRENT_REVIEWS=10
